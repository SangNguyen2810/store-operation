# API settings (all optional; these are the defaults). The gateway listens on :8080 and forwards here.
ADDR=:8081
DATABASE_URL=postgres://postgres:123456@localhost:5432/postgres
# Pagila's payments end on 2022-07-27, so "today" is pinned to it.
ASOF_DATE=2022-07-27

# Query cache. Unset (the default) means no cache. Start Redis with `make redis-up`.
# REDIS_URL=redis://localhost:6379
# How long a cached query result stays valid.
# CACHE_TTL=10m

# Gateway settings (its own process, in gateway/; all optional)
# ADDR=:8080
# UPSTREAM_URL=http://localhost:8081
# Requests per second for each client IP (0 turns the limit off) and the burst size.
# RATE_LIMIT_RPS=50
# RATE_LIMIT_BURST=100
# UPSTREAM_DIAL_TIMEOUT=2s
# UPSTREAM_HEADER_TIMEOUT=10s
