# Settings for the stores, ranges and analytics services (all optional; these are the defaults).
# Each service has its own ADDR: stores :8081, ranges :8083, analytics :8084 (the gateway listens on :8080).
DATABASE_URL=postgres://postgres:123456@localhost:5432/postgres
# Pagila's payments end on 2022-07-27, so "today" is pinned to it.
ASOF_DATE=2022-07-27

# The analytics service asks the ranges service which date ranges a request may use.
# RANGES_URL=http://localhost:8083

# Query cache: the URL of the redis service (see below). Unset (the default) means no cache.
# `make up` starts all of this in Docker. To run it yourself: `make redis-up` (Redis on :6380),
# then `REDIS_URL=redis://localhost:6380 make dev-redis` for the service.
# If the service is down, stores and analytics serve recent answers from memory, then falls back to the database.
# CACHE_URL=http://localhost:8082
# How long a cached query result stays valid.
# CACHE_TTL=10m

# Gateway settings (its own process, in app/gateway/; all optional)
# ADDR=:8080
# UPSTREAM_URL=http://localhost:8084
# ROUTES=/api/stores=http://localhost:8081,/api/presets=http://localhost:8083
# Requests per second for each client IP (0 turns the limit off) and the burst size.
# RATE_LIMIT_RPS=50
# RATE_LIMIT_BURST=100
# UPSTREAM_DIAL_TIMEOUT=2s
# UPSTREAM_HEADER_TIMEOUT=10s

# Redis service settings (its own process, in app/redis/; all optional)
# ADDR=:8082
# REDIS_URL=redis://localhost:6379
